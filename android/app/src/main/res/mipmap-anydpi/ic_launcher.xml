<?xml version="1.0" encoding="utf-8"?>
<!-- Unqualified (no -v26) since minSdk is 31 — every device this app runs on
     already supports adaptive icons, so the version qualifier is dead
     weight (flagged by lint's ObsoleteSdkInt). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Android 13+ themed-icon support: the system recolors this single
         layer to match the user's wallpaper palette, same glyph as
         foreground. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
